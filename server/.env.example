# ── Server ───────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospitality_erp
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── JWT ──────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_minimum_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Uploads ──────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5