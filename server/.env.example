# ── Server ───────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospitality_erp
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── JWT ──────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_minimum_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Uploads ──────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ── Backups ──────────────────────────────────────
# Automatic daily database backup into server/backups (set to false to disable)
BACKUP_AUTO=true
# How many automatic backups to keep
BACKUP_KEEP=14
# Only needed if pg_dump / pg_restore are not found automatically
# PG_DUMP_PATH=C:\Program Files\PostgreSQL8in\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL8in\pg_restore.exe

# ── Guest notifications (Systems → Notifications) ────────────────────────────
# Provider "manual" needs nothing. For automatic WhatsApp/SMS pick ONE of these:
# Twilio WhatsApp / SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SMS_FROM=+1xxxxxxxxxx
# Your own gateway: the system POSTs { to, message, event, channel } as JSON to this URL
# NOTIFY_WEBHOOK_URL=https://your-gateway.example/send
# NOTIFY_WEBHOOK_TOKEN=

# ── Online booking page ──────────────────────────────────────────────────────
# Booking requests allowed per network address per hour (default 8)
# BOOKING_RATE_LIMIT=8
